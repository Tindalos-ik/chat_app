QDialog#LoginDialog, #RegisterDialog{
background-color:rgb(255,255,255)
}


QLabel#err_tip[state="normal"]{
   color: green;
}

QLabel#err_tip[state="err"]{
   color: red;
}

ClickedLabel#pass_visible[state='unvisible']{
   border-image: url(:/res/unvisible.png);
}

ClickedLabel#pass_visible[state='unvisible_hover']{
   border-image: url(:/res/unvisible_hover.png);
}

ClickedLabel#pass_visible[state='visible']{
   border-image: url(:/res/visible.png);
}

ClickedLabel#pass_visible[state='visible_hover']{
   border-image: url(:/res/visible_hover.png);
}

ClickedLabel#confirm_visible[state='unvisible']{
   border-image: url(:/res/unvisible.png);
}

ClickedLabel#confirm_visible[state='unvisible_hover']{
   border-image: url(:/res/unvisible_hover.png);
}

ClickedLabel#confirm_visible[state='visible']{
   border-image: url(:/res/visible.png);
}

ClickedLabel#confirm_visible[state='visible_hover']{
   border-image: url(:/res/visible_hover.png);
}

ClickedLabel#forget_pwd_label[state='normal'],#forget_pwd_label[state='selected']{
   color: black;
}

ClickedLabel#forget_pwd_label[state='hover'],#forget_pwd_label[state='selected_hover']{
   color: rgb(42,112,241);
}


/* ================= 侧边栏 StateWidget =================
 * 聊天：选中态用 select_hover / select_press 两张图（与 hover/press 同图）
 * 联系人：没有单独的选中图，选中态复用 press 图
 * 设置：选中态用 select_hover / select_press
 */
StateWidget#side_chat_lb[state='normal']{
   border-image: url(:/res/chat_icon.png);
}

StateWidget#side_chat_lb[state='hover']{
   border-image: url(:/res/chat_icon_hover.png);
}

StateWidget#side_chat_lb[state='pressed']{
   border-image: url(:/res/chat_icon_press.png);
}

/* 选中态统一用绿色（与 press 图一致，主题绿 #07c160） */
StateWidget#side_chat_lb[state='selected'],
StateWidget#side_chat_lb[state='selected_hover'],
StateWidget#side_chat_lb[state='selected_pressed']{
   border-image: url(:/res/chat_icon_select_press.png);
}

StateWidget#side_contact_lb[state='normal']{
   border-image: url(:/res/contact_list.png);
}

StateWidget#side_contact_lb[state='hover']{
   border-image: url(:/res/contact_list_hover.png);
}

StateWidget#side_contact_lb[state='pressed'],
StateWidget#side_contact_lb[state='selected'],
StateWidget#side_contact_lb[state='selected_hover'],
StateWidget#side_contact_lb[state='selected_pressed']{
   border-image: url(:/res/contact_list_press.png);
}

StateWidget#side_settings_lb[state='normal']{
   border-image: url(:/res/settings.png);
}

StateWidget#side_settings_lb[state='hover']{
   border-image: url(:/res/settings_hover.png);
}

StateWidget#side_settings_lb[state='pressed']{
   border-image: url(:/res/settings_press.png);
}

/* 选中态统一用绿色 */
StateWidget#side_settings_lb[state='selected'],
StateWidget#side_settings_lb[state='selected_hover'],
StateWidget#side_settings_lb[state='selected_pressed']{
   border-image: url(:/res/settings_select_press.png);
}

StateWidget#side_group_notifications_lb[state='normal']{
   border-image: url(:/res/group_notifications_normal.png);
}
StateWidget#side_group_notifications_lb[state='hover']{
   border-image: url(:/res/group_notifications_hover.png);
}
StateWidget#side_group_notifications_lb[state='pressed'],
StateWidget#side_group_notifications_lb[state='selected'],
StateWidget#side_group_notifications_lb[state='selected_hover'],
StateWidget#side_group_notifications_lb[state='selected_pressed']{
   border-image: url(:/res/group_notifications_selected.png);
}

/* 侧边栏按钮右上角的红点（新消息 / 新好友申请提示） */
StateWidget QLabel#red_point{
   border-image: url(:/res/red_point.png);
}


/* 用户与群入口共用提示行；表单和结果留在搜索面板内。 */
AddUserItem QLabel#search_entry_icon{
   background: transparent;
}
AddUserItem QLabel#search_entry_arrow{
   background: transparent;
   color: #999999;
   font-size: 20px;
}

AddUserItem #message_tip{
   font-family: "Microsoft YaHei";
   font-size: 14px;
   color: #333333;
}

/* 搜索列表整行悬停/选中高亮（提示项背景透明，高亮会透出来） */
QListWidget#search_list::item{
   border-radius: 6px;
   background: transparent;
}
QListWidget#search_list::item:hover{
   background-color: #e3e7e5;
}
QListWidget#search_list::item:selected{
   background-color: #d8eee2;
}
QWidget#group_search_card{
   background: #ffffff;
   border-radius: 8px;
}
QWidget#group_search_card QLabel{
   background: transparent;
   border: none;
   color: #333333;
   font-size: 13px;
}
QWidget#group_search_card QLabel#group_search_heading,
QWidget#group_search_card QLabel#group_search_name{
   font-weight: bold;
}
QWidget#group_search_card QLabel#group_search_number,
QWidget#group_search_card QLabel#group_search_status{
   color: #758078;
   font-size: 12px;
}
QWidget#group_search_card QLabel#group_search_status[error="true"]{
   color: #c23b3b;
}
QLineEdit#group_search_form{
   border: 1px solid #dcdcdc;
   border-radius: 5px;
   padding: 6px;
   background: #ffffff;
   color: #333333;
}
QLineEdit#group_search_form:focus{
   border-color: #07c160;
}
QPushButton#group_search_submit{
   border: none;
   border-radius: 5px;
   padding: 7px 8px;
   background: #07c160;
   color: #ffffff;
}
QPushButton#group_search_submit:hover{
   background: #06ad56;
}
QPushButton#group_search_submit:disabled{
   background: #e3e8e5;
   color: #909992;
}

/* 嵌入式群通知沿用现有白色内容区与主题绿。 */
QWidget#group_requests_page, QWidget#group_approvals_page{
   background: #ffffff;
}
#group_requests_page QLabel#group_notifications_title{
   color: #333333;
   font-size: 17px;
   font-weight: bold;
   padding-bottom: 6px;
}
#group_requests_page QTabWidget::pane{
   border: 1px solid #e5e8e6;
   border-radius: 6px;
}
#group_requests_page QTabBar::tab{
   background: #f0f1f2;
   color: #68716b;
   padding: 9px 16px;
   border: none;
}
#group_requests_page QTabBar::tab:selected{
   background: #e1f3e9;
   color: #078a45;
}
#group_requests_page QListWidget, #group_approvals_page QListWidget{
   border: none;
   background: #ffffff;
   color: #333333;
   font-size: 13px;
}
#group_requests_page QListWidget::item, #group_approvals_page QListWidget::item{
   padding: 12px 8px;
   border-bottom: 1px solid #eef0ef;
}
#group_requests_page QListWidget::item:hover, #group_approvals_page QListWidget::item:hover{
   background: #f0f5f2;
}
#group_requests_page QListWidget::item:selected, #group_approvals_page QListWidget::item:selected{
   background: #e1f3e9;
   color: #24583b;
}
#group_requests_page QLabel, #group_approvals_page QLabel{
   background: transparent;
   color: #68716b;
   font-size: 13px;
}
#group_requests_page QPushButton, #group_approvals_page QPushButton{
   background: #f0f5f2;
   border: 1px solid #dce6df;
   border-radius: 5px;
   padding: 6px 12px;
   color: #24653e;
}
#group_requests_page QPushButton:hover, #group_approvals_page QPushButton:hover{
   background: #e1f3e9;
   border-color: #07c160;
}
#group_requests_page QPushButton:disabled, #group_approvals_page QPushButton:disabled{
   color: #a0a7a2;
   border-color: #e7eae8;
}


/* ================= 联系人列表 ================= */
/* "联系人"分组标题 */
#group_tip {
    background-color: #f0f1f2;
}

QLabel#group_tip_lb {
    color: #999999;
    font-size: 13px;
}

/* 整行悬停/选中高亮 */
QListWidget#contact_list::item:hover{
   background-color: rgb(206,207,208);
}

QListWidget#contact_list::item:selected{
   background-color: rgb(211,215,212);
}


/* ================= ApplyFriend 添加好友弹窗 ================= */
#ApplyFriend {
    border: 2px solid #f1f1f1;
    font-size: 14px;
    background: #f7f7f8;
}

/* 推荐标签（tipslb）：做成小胶囊，未选中浅灰、选中变绿色胶囊 */
#apply_wid #tipslb {
    padding: 2px 6px;
    border-radius: 12px; /* 更圆润 */
}

#apply_wid #tipslb[state='normal'],#apply_wid #tipslb[state='hover'] {
    background-color: #e1e1e1;
    color: #1e1e1e;
}

#apply_wid #tipslb[state='pressed'],
#apply_wid #tipslb[state='selected_normal'],
#apply_wid #tipslb[state='selected_hover'] {
    background-color: #daf6e7; /* 选中 = 绿色胶囊，和好友标签风格一致 */
    color: #48bf56;
}

#apply_wid #tipslb[state='selected_pressed'] {
    background-color: #daf6e7;
    color: #1e1e1e;
}

#apply_wid #more_lb {
    border-image: url(:/res/arowdown.png); /* "更多"下拉箭头 */
}

#input_tip_wid {
    background: #d3eaf8;
}

#apply_wid #tip_lb {
    padding-left: 2px;
    color: rgb(153,153,153);
}

#gridWidget {
    background: #fdfdfd;
}







