QDialog#LoginDialog, #RegisterDialog{
background-color:rgb(255,255,255)
}


QLabel#err_tip[state="normal"]{
   color: green;
}

QLabel#err_tip[state="err"]{
   color: red;
}

ClickedLabel#pass_visible[state='unvisible']{
   border-image: url(:/res/unvisible.png);
}

ClickedLabel#pass_visible[state='unvisible_hover']{
   border-image: url(:/res/unvisible_hover.png);
}

ClickedLabel#pass_visible[state='visible']{
   border-image: url(:/res/visible.png);
}

ClickedLabel#pass_visible[state='visible_hover']{
   border-image: url(:/res/visible_hover.png);
}

ClickedLabel#confirm_visible[state='unvisible']{
   border-image: url(:/res/unvisible.png);
}

ClickedLabel#confirm_visible[state='unvisible_hover']{
   border-image: url(:/res/unvisible_hover.png);
}

ClickedLabel#confirm_visible[state='visible']{
   border-image: url(:/res/visible.png);
}

ClickedLabel#confirm_visible[state='visible_hover']{
   border-image: url(:/res/visible_hover.png);
}

ClickedLabel#forget_pwd_label[state='normal'],#forget_pwd_label[state='selected']{
   color: black;
}

ClickedLabel#forget_pwd_label[state='hover'],#forget_pwd_label[state='selected_hover']{
   color: rgb(42,112,241);
}


/* ================= 侧边栏 StateWidget =================
 * 聊天：选中态用 select_hover / select_press 两张图（与 hover/press 同图）
 * 联系人：没有单独的选中图，选中态复用 press 图
 * 设置：选中态用 select_hover / select_press
 */
StateWidget#side_chat_lb[state='normal']{
   border-image: url(:/res/chat_icon.png);
}

StateWidget#side_chat_lb[state='hover']{
   border-image: url(:/res/chat_icon_hover.png);
}

StateWidget#side_chat_lb[state='pressed']{
   border-image: url(:/res/chat_icon_press.png);
}

/* 选中态统一用绿色（与 press 图一致，主题绿 #07c160） */
StateWidget#side_chat_lb[state='selected'],
StateWidget#side_chat_lb[state='selected_hover'],
StateWidget#side_chat_lb[state='selected_pressed']{
   border-image: url(:/res/chat_icon_select_press.png);
}

StateWidget#side_contact_lb[state='normal']{
   border-image: url(:/res/contact_list.png);
}

StateWidget#side_contact_lb[state='hover']{
   border-image: url(:/res/contact_list_hover.png);
}

StateWidget#side_contact_lb[state='pressed'],
StateWidget#side_contact_lb[state='selected'],
StateWidget#side_contact_lb[state='selected_hover'],
StateWidget#side_contact_lb[state='selected_pressed']{
   border-image: url(:/res/contact_list_press.png);
}

StateWidget#side_settings_lb[state='normal']{
   border-image: url(:/res/settings.png);
}

StateWidget#side_settings_lb[state='hover']{
   border-image: url(:/res/settings_hover.png);
}

StateWidget#side_settings_lb[state='pressed']{
   border-image: url(:/res/settings_press.png);
}

/* 选中态统一用绿色 */
StateWidget#side_settings_lb[state='selected'],
StateWidget#side_settings_lb[state='selected_hover'],
StateWidget#side_settings_lb[state='selected_pressed']{
   border-image: url(:/res/settings_select_press.png);
}

/* 侧边栏按钮右上角的红点（新消息 / 新好友申请提示） */
StateWidget QLabel#red_point{
   border-image: url(:/res/red_point.png);
}


/* ================= 搜索列表：添加用户提示项 ================= */
AddUserItem #add_tip{
   border-image: url(:/res/addtip.png);
}

AddUserItem #right_tip{
   border-image: url(:/res/right_tip.png);
}

AddUserItem #message_tip{
   font-family: "Microsoft YaHei";
   font-size: 14px;
   color: #333333;
}

/* 搜索列表整行悬停/选中高亮（提示项背景透明，高亮会透出来） */
QListWidget#search_list::item:hover{
   background-color: rgb(206,207,208);
}

QListWidget#search_list::item:selected{
   background-color: rgb(211,215,212);
}







