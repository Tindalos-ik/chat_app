  <property name="windowTitle"><string>个人设置</string></property>
  <property name="styleSheet"><string notr="true">QDialog#SettingDialog { background-color: #ffffff; font-family: &quot;Microsoft YaHei&quot;; }
QLabel#page_title { font-size: 22px; font-weight: 600; color: #191919; }
QLabel#page_subtitle { font-size: 13px; color: #8c8c8c; }
QWidget#header_wid { border-bottom: 1px solid #ededed; }
QWidget#avatar_card { background: #f7f8fa; border: 1px solid #eeeeee; border-radius: 10px; }
QLabel#avatar_lb { background: #ffffff; border: 3px solid #ffffff; border-radius: 54px; }
QLabel#avatar_tip { font-size: 15px; font-weight: 600; color: #333333; }
QLabel#avatar_hint, QLabel#username_hint { font-size: 12px; color: #999999; }
QProgressBar#upload_progress { min-height: 14px; max-height: 14px; border: 1px solid #d9d9d9; border-radius: 7px; background: #ffffff; color: #666666; font-size: 10px; text-align: center; }
QProgressBar#upload_progress::chunk { border-radius: 6px; background: #07c160; }
QLabel#form_label { font-size: 14px; color: #4b4b4b; }
QLineEdit, QTextEdit { background: #ffffff; border: 1px solid #dedede; border-radius: 5px; color: #333333; font-size: 14px; padding: 0 10px; }
QLineEdit { min-height: 38px; }
QTextEdit { padding: 8px 10px; }
QLineEdit:focus, QTextEdit:focus { border: 1px solid #07c160; }
QLineEdit#username_edit { background: #f7f7f7; color: #888888; }
QPushButton { min-height: 36px; border-radius: 5px; font-size: 14px; padding: 0 20px; }
QPushButton#select_avatar_btn { background: #ffffff; color: #333333; border: 1px solid #d9d9d9; }
QPushButton#select_avatar_btn:hover { background: #f2f2f2; }
QPushButton#select_avatar_btn:pressed { background: #e8e8e8; }
QPushButton#cancel_btn { background: #ffffff; color: #444444; border: 1px solid #d9d9d9; }
QPushButton#cancel_btn:hover { background: #f5f5f5; }
QPushButton#submit_btn { background: #07c160; color: #ffffff; border: none; font-weight: 600; }
QPushButton#submit_btn:hover { background: #06ad56; }
QPushButton#submit_btn:pressed { background: #059a4c; }</string></property>
